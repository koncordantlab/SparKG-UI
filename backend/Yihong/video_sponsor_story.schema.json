  "required": [
    "schema_version",
    "video",
    "summary_columns",
    "pipeline_stages"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "video": {
      "type": "object"
    },
    "summary_columns": {
      "type": "object"
    },
    "sponsor_explanation": {
      "type": "object"
    },
    "pipeline_stages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "drug_properties": {
      "type": "array"
    },
    "label_assignment": {
      "type": "object"
    },
    "education_session": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    }
  }
